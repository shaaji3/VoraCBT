#!/usr/bin/env php
<?php

declare(strict_types=1);

// This deployment currently uses the database-backed queue table.
// Keep redis-style flags for supervisor compatibility, but process jobs via DatabaseQueue.

require __DIR__ . '/../vendor/autoload.php';

use App\Core\Config\Environment;
use App\Core\Database\DatabaseManager;
use App\Infrastructure\Queue\DatabaseQueue;

Environment::getInstance();

$options = getopt('', ['queue::', 'sleep::', 'tries::', 'memory::', 'max-jobs::', 'max-time::']);
$queueName = (string) ($options['queue'] ?? 'default');
$sleep = max(1, (int) ($options['sleep'] ?? 1));
$tries = max(1, (int) ($options['tries'] ?? 3));
$memory = max(64, (int) ($options['memory'] ?? 512));
$maxJobs = max(1, (int) ($options['max-jobs'] ?? 500));
$maxTime = max(1, (int) ($options['max-time'] ?? 300));

$db = DatabaseManager::getConnection();
$queue = new DatabaseQueue($db);
$startedAt = time();
$processed = 0;

while (true) {
    if ((time() - $startedAt) >= $maxTime || $processed >= $maxJobs) {
        break;
    }

    $job = $queue->pop();
    if ($job === null) {
        sleep($sleep);
        continue;
    }

    $attempt = 0;
    while (true) {
        try {
            $job->handle();
            break;
        } catch (Throwable $e) {
            $attempt++;
            if ($attempt >= $tries) {
                fwrite(STDERR, '[queue-work-redis:' . $queueName . '] job failed after retries: ' . $e->getMessage() . PHP_EOL);
                break;
            }
        }
    }

    $processed++;

    if (memory_get_usage(true) > ($memory * 1024 * 1024)) {
        fwrite(STDERR, '[queue-work-redis:' . $queueName . '] memory limit reached; stopping worker.' . PHP_EOL);
        break;
    }
}

echo sprintf("queue-work-redis queue=%s processed=%d tries=%d\n", $queueName, $processed, $tries);
